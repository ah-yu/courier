{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Repository tooling, not shipped code: it runs under `bun` and imports the
    // packages by relative path, so it shares their Bun/DOM lib settings.
    "types": ["bun"],
    // The scripts import their own siblings and the harness modules by their real
    // `.ts` path.
    "allowImportingTsExtensions": true,
    // These scripts were written as plain JavaScript and are executed by Bun, which
    // strips types without checking them. The gate catches what actually breaks (an
    // import that no longer exists, a property or arity that changed). Two rules are
    // relaxed for that reason: implicit `any`, and the rest of the strictness family,
    // which turns empty-array and empty-object initialisers into errors in code that
    // was never written for it.
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["eslint.config.ts", "scripts/**/*.ts", "packages/*/scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
