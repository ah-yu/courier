node_modules/
dist/
.env
.env.local
*.tsbuildinfo
.vite/
.DS_Store

# The plugin dev loop's vaults: `vault_a` / `vault_b` in the primary checkout, and a
# suffixed pair per linked worktree (`vault_a-fix-cli-status-lag`), so two checkouts never
# compete for one Obsidian vault name (see packages/plugin/scripts/dev-vaults.mjs).
vault_a/
vault_b/
vault_a-*/
vault_b-*/
# What `bun run dev` remembers about the dev account (the host key, the server vault).
.courier-dev/
# Disposable vaults for the real-Obsidian end-to-end suite (`bun run e2e:obsidian setup`)
.e2e-vaults/

plans/

# Packaged artifacts — reproducible via `bun run --filter @courier/cli build`
packages/cli/build/

# The Bun runtimes `bun build --compile` downloads once per cross-compile target.
.bun-cache/

# Test-run artifacts: the v8 coverage report (`bun run test:coverage`) and what an optional
# mutation survey leaves behind (`docs/mutation-testing.md` — the tool itself is not a
# dependency, so these only appear while one is being run).
coverage/
reports/mutation/
.stryker-tmp/
# The console log a local `bun run verify` run can tee to while reading its summary.
.verify.log

# What `bun run preview:ui` renders (`docs/plugin-ui-preview.md`): a PNG per look, plus the page
# and stylesheet it was drawn from. Reproducible, and only interesting while iterating.
.agents/ui-preview/