{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // `DOM.Iterable` for the code that walks a `NodeList` (`for…of`); without it the type
    // is only indexable, and a linter reading the project sees `any` at every element.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
