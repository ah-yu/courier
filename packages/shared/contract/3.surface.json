  "routes": {
    "/api/admin/runtime": ["GET"],
    "/api/admin/status": ["GET"],
    "/api/health": ["GET"],
    "/api/me": ["GET"],
    "/api/users": ["GET","POST"],
    "/api/users/:id": ["DELETE","PATCH"],
