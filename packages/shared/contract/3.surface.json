    "/api/vaults": ["GET","POST"],
    "/api/vaults/:id": ["DELETE","PATCH"],
    "/api/vaults/:id/encryption-salt": ["GET"],
    "/api/vaults/:id/key-check": ["GET"],
    "/api/vaults/:id/sync/blobs/:contentHash/chunks/:index": ["PUT"],
    "/api/vaults/:id/sync/blobs/:contentHash/status": ["GET"],
    "/api/vaults/:id/sync/contents": ["POST"],
    "/api/vaults/:id/sync/deleted": ["GET"],
    "/api/vaults/:id/sync/deleted/clear": ["POST"],
    "/api/vaults/:id/sync/history": ["GET"],
    "/api/vaults/:id/sync/index": ["GET"],
    "/api/vaults/:id/sync/pull": ["POST"],
    "/api/vaults/:id/sync/push": ["POST"],
    "/api/vaults/:id/sync/versions": ["GET"],
    "/api/vaults/:id/sync/versions/:contentHash/content": ["GET","HEAD"]
  },
  "constants": {
    "API_ERROR_CODES": "[ \"VALIDATION_ERROR\", \"UNAUTHORIZED\", \"NOT_FOUND\", \"KEY_EXPIRED\", \"KEY_DISABLED\", \"INSUFFICIENT_SCOPE\", \"CONTRACT_MISMATCH\", \"RATE_LIMITED\", \"QUOTA_EXCEEDED\", \"VAULT_LIMIT_REACHED\", \"PAYLOAD_TOO_LARGE\", \"RANGE_NOT_SATISFIABLE\", \"INTERNAL_ERROR\", ] as const",
    "API_KEY_SCOPES": "[\"admin\", \"status\", \"users\"] as const",
    "BLOB_FLAG_CHUNK_AAD": "1",
    "BLOB_HEADER_BYTES": "24",
    "BLOB_MAGIC": "\"CBR2\"",
    "CHUNKED_TRANSFER_THRESHOLD": "8 * 1024 * 1024",
    "CHUNK_PLAINTEXT_BYTES": "4 * 1024 * 1024",
    "CHUNK_STORED_BYTES": "CHUNK_PLAINTEXT_BYTES + 28",
    "CONTENT_BATCH_HEADER_BYTES": "CONTENT_BATCH_MAGIC.length + 4",
    "CONTENT_BATCH_MAGIC": "\"CBC1\"",
    "CONTENT_HASH_PATTERN": "/^[a-f0-9]{64}$/",
    "CONTRACT_HEADER": "\"X-Courier-Contract\"",
    "HISTORY_KINDS": "[\"documents\", \"attachments\"] as const",
    "KEY_CHECK_VALUE": "\"courier-key-check\"",
    "MAX_CHUNKS": "1_048_576",
    "MAX_CONTENT_BATCH_BYTES": "16 * 1024 * 1024",
    "MAX_CONTENT_BATCH_FILES": "64",
    "MAX_DEVICE_NAME_LENGTH": "100",
    "MAX_ENCRYPTED_PATH_LENGTH": "512",
    "MAX_HISTORY_LIMIT": "10_000",
    "MAX_ID_LENGTH": "64",
    "MAX_PULL_BATCH_FILES": "200",
    "MAX_PUSH_BATCH_FILES": "100",
    "MAX_PUSH_HEADER_BYTES": "1024 * 1024",
    "PUSH_HEADER_LENGTH_BYTES": "4",
    "SYNC_ACTIONS": "[\"create\", \"modify\", \"rename\", \"delete\", \"restore\"] as const"
  }
}
