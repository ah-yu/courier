{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Type-check only — this package ships no runtime artifact, it only runs
    // under Vitest. `lib` gains DOM because the Obsidian stub mimics
    // `requestUrl`'s `fetch`-like surface.
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    // Sibling packages are imported by relative path, so their own `hono` /
    // `obsidian` / … resolve from their own node_modules. The single exception
    // is the `obsidian` module that the plugin sources import: outside the app
    // it exists only as types, and Bun links it into the plugin package.
    "paths": {
      "obsidian": ["../plugin/node_modules/obsidian"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
